# /opt/biibo/.env trên VPS. Toàn bộ biến của API (xem biibo-backend/.env.example)
# cũng nằm trong file này, vì service `api` nạp nó qua env_file.

# --- Chỉ dành cho production (docker-compose.prod.yml trên VPS) ---
# Ba biến dưới đây không dùng ở máy dev. Trên VPS chúng nằm trong /opt/biibo/.env,
# cùng file mà service `api` nạp qua env_file.
#
# Mật khẩu Postgres và Redis. Dev dùng biibo/biibo và Redis không mật khẩu;
# trên máy có IP công cộng cả hai đều phải đặt thật (`openssl rand -base64 24`).
# Compose sẽ từ chối khởi động nếu thiếu, thay vì lặng lẽ chạy với mặc định.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Bản image đang chạy, mỗi app một biến. CI của từng repo ghi đè biến của mình
# sau mỗi lần deploy, nên `docker compose up -d` chạy tay sau đó vẫn dựng đúng
# bản đang chạy thay vì nhảy sang :latest. IMAGE_TAG chỉ còn là giá trị dự phòng.
API_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest
